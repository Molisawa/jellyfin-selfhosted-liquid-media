# Copia a .env y ajusta. NUNCA subas .env al repo.

# --- General ---
# macOS (Docker Desktop): da igual el valor. Linux/WSL2: usa `id -u` / `id -g`.
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Almacenamiento ---
# Raíz única para hardlinks: contiene torrents/ y media/.
# macOS:   ./dev-data (pruebas) o /Volumes/<disco>/data (disco en APFS, no exFAT)
# Windows: /mnt/d/MediaServer/data (compose corre DENTRO de WSL2) o un disco ext4 montado en WSL
# Ver docs/despliegue-mac.md o docs/despliegue-windows.md antes de elegir.
MEDIA_PATH=./dev-data

# --- Red / dominio ---
# localhost -> pruebas locales: watch.localhost / request.localhost con TLS interno de Caddy.
# Tu dominio (ej. example.com) -> acceso remoto con Let's Encrypt automático.
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# IP del host donde se publican los paneles admin (Sonarr, Radarr, etc.).
# 127.0.0.1 = solo este equipo. 0.0.0.0 = toda la LAN (con el firewall del sistema activo).
# Estos puertos NUNCA se abren en el router.
LAN_BIND_IP=127.0.0.1

# --- Perfiles ---
# novpn = qBittorrent directo  |  vpn = qBittorrent detrás de Gluetun
COMPOSE_PROFILES=novpn

# --- Gluetun (solo con COMPOSE_PROFILES=vpn) ---
# Ver https://github.com/qdm12/gluetun-wiki para los valores de tu proveedor.
VPN_SERVICE_PROVIDER=changeme
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=changeme
WIREGUARD_ADDRESSES=changeme
SERVER_COUNTRIES=
